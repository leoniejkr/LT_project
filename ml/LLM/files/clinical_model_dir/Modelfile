# Ollama Modelfile für das finetunende TrustAI Clinical LLM
# (Llama-3-8B-Instruct, Q4_K_M, merged & exported via Unsloth).
#
# Registriert das Modell in Ollama als "trustai-llm:latest":
#   ollama create trustai-llm -f Modelfile
#
# Das GGUF wird über ein beim Start gemountetes Verzeichnis gefunden
# (siehe docker-compose.yaml: ollama -> /models).

FROM /models/llama-3-8b-Instruct.Q4_K_M.gguf

# Konservative Inferenz-Parameter für die klinische Analyse.
PARAMETER temperature 0.3
PARAMETER num_ctx 2048
PARAMETER num_predict 512

# Systemprompt für die klinische Befundbewertung (Reasoning-Schritt).
SYSTEM """You are a medical AI assistant analyzing chest X-ray findings. Provide concise, professional clinical assessments of the detected conditions. Only answer based on the information provided in the prompt. Be accurate and do not invent conditions."""
