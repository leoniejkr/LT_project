      ],
      "orientation": "RAS",
      "normalization": "z-score (nonzero voxels, channel-wise)",
      "output_format": "NIfTI (.nii.gz)"
    },
    "cxr": {
      "target_shape_pixels": [
        224,
        224
      ],
      "contrast_enhancement": "CLAHE (clip_limit=0.03)",
      "normalization": "ImageNet-style mean/std (0.485 / 0.229)",
      "output_format": "NumPy (.npy)"
    }
  }
