# Production-Build für den Modelling-Service.
#
# WICHTIG: Dieser Build erwartet den Build-Context im REPO-ROOT (`.`), weil das
# trainierte Modell aus `./checkpoints` mit ins Image gebacken wird. Siehe
# docker-compose.prod.yaml:
#
#   modelling:
#     build:
#       context: .
#       dockerfile: services/model-api/Dockerfile.prod
#
FROM python:3.11-slim AS prod

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY services/model-api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Quellcode des Modelling-Service
COPY services/model-api/*.py .

# Modellgewichte sind NICHT in git (zu gross fuer GitHub). Sie werden beim
# Build vom Hugging Face Hub geladen (siehe scripts/download_models.py), damit
# das Image selbststaendig ist und ohne Model-Datei verteilt werden kann.
# Fuer private Repos: HF_TOKEN als Build-Arg setzen (docker compose build --build-arg HF_TOKEN=...).
ARG MODEL_REPO="leoniejkr/lt-models"
ARG HF_TOKEN=""
ARG MODEL_FILES=""
COPY scripts/download_models.py .
RUN MODEL_REPO="$MODEL_REPO" HF_TOKEN="$HF_TOKEN" MODEL_FILES="$MODEL_FILES" MODEL_DIR=/app/checkpoints python download_models.py

ENV CHECKPOINT_PATH=/app/checkpoints/covnext348.pth
ENV SWIN_CHECKPOINT_PATH=/app/checkpoints/swin-224px_final.pth

# gunicorn statt des Flask-Dev-Servers (ein Worker, da das Modell im
# Prozessspeicher gehalten wird und die Inferenz synchron läuft).
CMD ["gunicorn", "-w", "1", "-b", "0.0.0.0:5000", "--access-logfile", "-", "main:app"]
