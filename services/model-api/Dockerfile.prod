# Production-Build für den Modelling-Service.
#
# WICHTIG: Dieser Build erwartet den Build-Context im REPO-ROOT (`.`), weil die
# trainierten Klassifikator-Gewichte aus `checkpoints/` (Git LFS) mit ins Image
# kopiert werden. Siehe docker-compose.prod.yaml:
#
#   modelling:
#     build:
#       context: .
#       dockerfile: services/model-api/Dockerfile.prod
#
FROM python:3.11-slim AS prod

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY services/model-api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Quellcode des Modelling-Service
COPY services/model-api/*.py .

# Die CNN-Gewichte liegen seit Git LFS direkt im Repo (`checkpoints/`, siehe
# .gitattributes, via .dockerignore in den Build-Context gefiltert) und werden
# hier mitkopiert. WICHTIG: der Build braucht die REALEN Dateien — beim Klonen
# zuerst `git lfs install`/`git lfs pull` ausführen, sonst landen nur kleine
# LFS-Pointer-Texte im Image und die Inferenz schlägt beim Laden fehl. Ein
# Guard bricht den Build deshalb ab, wenn ein Checkpoint zu klein ist.
COPY checkpoints/ /app/checkpoints/
RUN python -c "import pathlib,sys; bad=[p for p in pathlib.Path('/app/checkpoints').glob('*.pth') if p.stat().st_size<100_000_000]; (sys.exit('LFS-Pointer statt Gewichten: %s - git lfs install && git lfs pull vergessen?' % bad) if bad else None)"

ENV CHECKPOINT_PATH=/app/checkpoints/covnext348.pth
ENV SWIN_CHECKPOINT_PATH=/app/checkpoints/swin-224px_final.pth

# gunicorn statt des Flask-Dev-Servers (ein Worker, da das Modell im
# Prozessspeicher gehalten wird und die Inferenz synchron läuft).
CMD ["gunicorn", "-w", "1", "-b", "0.0.0.0:5000", "--access-logfile", "-", "main:app"]
