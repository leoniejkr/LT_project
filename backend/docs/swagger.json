{
    "swagger": "2.0",
    "info": {
        "description": "API for upload of patient data and LLM analysis results",
        "title": "TrustAI API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/analysis": {
            "post": {
                "description": "Creates a new patient with metadata and X-Ray files, then triggers LLM analysis. Returns patient data + analysis result.",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "analysis"
                ],
                "summary": "Create patient and run LLM analysis",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Patient metadata as JSON string",
                        "name": "formData",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "X-Ray image files (multiple allowed)",
                        "name": "xray_files",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            },
            "delete": {
                "description": "Deletes all patients, analyses, and X-Ray files. Used when starting a new analysis.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "analysis"
                ],
                "summary": "Delete all analysis data",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    }
}