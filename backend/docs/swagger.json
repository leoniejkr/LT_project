{
    "swagger": "2.0",
    "info": {
        "description": "API for upload of patient data and LLM analysis results",
        "title": "TrustAI API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/patients": {
            "post": {
                "description": "Creates new patient with the provided metadata and dicom images",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "patients"
                ],
                "summary": "Create a new patient",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Patienten-Metadata as JSON-String",
                        "name": "formData",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "The .dcm picture data",
                        "name": "dicom_file",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}