{
// von der KI generieren lassen 
    "name": "Go Dev Environment",
    "image": "mcr.microsoft.com/devcontainers/go:1-25",

    // Features fügen zusätzliche Tools hinzu (z.B. Docker-in-Docker oder Git)
    "features": {
        "ghcr.io/devcontainers/features/common-utils:1": {
            "configureZshAsDefaultShell": true
        }
    },

    // Einstellungen, die im VS Code innerhalb des Containers gelten
    "customizations": {
        "vscode": {
            "settings": {
                "go.toolsManagement.checkForUpdates": "local",
                "go.useLanguageServer": true,
                "go.gopath": "/go",
                "editor.formatOnSave": true,
                "editor.codeActionsOnSave": {
                    "source.organizeImports": "always"
                }
            },
            "extensions": [
                "golang.go",           // Die essenzielle Go-Extension
                "irongeek.vscode-env", // Hilft bei .env Dateien
                "stkb.rewrap"          // Optional: Hilft bei Kommentaren
            ]
        }
    },

    // Verhindert, dass der Container sofort stoppt
    "overrideCommand": false,

    // Mountet deine lokale Docker-Socket, falls du Docker im Container nutzen willst
    "mounts": [
        "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
    ],

    // Befehl, der nach dem Erstellen des Containers ausgeführt wird
    "postCreateCommand": "go version",

    // Als welcher User gearbeitet wird (Standard bei diesem Image ist 'vscode')
    "remoteUser": "vscode"
}